# ── Core ──────────────────────────────────────────────────────────────────────
APP_ENV=local
BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/taxintel

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ENABLE_OPENAI=true

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Redis / Worker ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object Storage ────────────────────────────────────────────────────────────
# Local dev: leave S3_ENDPOINT_URL pointing at MinIO; blank for AWS S3
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=ap-south-1
S3_BUCKET=taxintel-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── PII Encryption ────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ── Phase 1B — Razorpay ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_SUPPLIER_LEGAL_NAME=Associate Piyush & Co.
BILLING_SUPPLIER_TRADE_NAME=AssociatePiyush
BILLING_SUPPLIER_GSTIN=__SET_BEFORE_GO_LIVE__
BILLING_SUPPLIER_STATE_CODE=07
BILLING_SUPPLIER_ADDRESS_JSON={"line1":"","city":"New Delhi","state":"Delhi","pincode":"110001"}
BILLING_INVOICE_PREFIX=APC
BILLING_HSN_SAC=998314

# ── Phase 1C — Digio ──────────────────────────────────────────────────────────
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_BASE_URL=https://ext.digio.in
DIGIO_WEBHOOK_SECRET=
DIGIO_DEFAULT_EXPIRY_DAYS=30

# ── Phase 1D — DigiLocker ─────────────────────────────────────────────────────
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://api.associatepiyush.in/api/v1/digilocker/callback
DIGILOCKER_BASE_URL=https://api.digitallocker.gov.in

# ── Phase 1E — Meta / WhatsApp ────────────────────────────────────────────────
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v22.0
