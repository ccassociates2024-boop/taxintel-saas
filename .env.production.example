# ============================================================
#  TaxIntel SaaS — Production Environment Variables
#  Set ALL of these in your Railway backend service dashboard
# ============================================================

# ── Core (REQUIRED) ──────────────────────────────────────────
APP_ENV=production
DATABASE_URL=postgresql+psycopg://...   # auto-set by Railway PostgreSQL plugin
BASE_URL=https://your-backend.up.railway.app

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# Vercel frontend URL (set after Vercel deploy)
CORS_ORIGINS=https://your-app.vercel.app

# ── File Storage — Cloudflare R2 (free, recommended) ─────────
# Create bucket at dash.cloudflare.com → R2 → Create bucket
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=taxintel-uploads
S3_ACCESS_KEY=CLOUDFLARE_R2_ACCESS_KEY_ID
S3_SECRET_KEY=CLOUDFLARE_R2_SECRET_ACCESS_KEY

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Optional integrations (leave blank to disable) ───────────
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# OPENAI_API_KEY=sk-...
# SENTRY_DSN=https://...@sentry.io/...

# ── Vercel frontend env var (set in Vercel dashboard) ─────────
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
